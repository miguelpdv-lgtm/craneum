{
  "$description": "Marea Rizada · design tokens (formato W3C Design Tokens)",
  "color": {
    "brand": {
      "espuma":  { "$type": "color", "$value": "#9EE5E7", "$description": "Aqua del logo. Color héroe." },
      "marea":   { "$type": "color", "$value": "#1C6F75", "$description": "Acciones y texto de acento." },
      "abismo":  { "$type": "color", "$value": "#0F3236", "$description": "Fondo marino, modo oscuro." },
      "concha":  { "$type": "color", "$value": "#CDAA9C", "$description": "Arena rosada del sol del logo." },
      "arcilla": { "$type": "color", "$value": "#9A5B49", "$description": "Acento cálido legible." },
      "roca":    { "$type": "color", "$value": "#3D4643", "$description": "Texto. Gris del rotulado." },
      "sal":     { "$type": "color", "$value": "#F2F8F7", "$description": "Fondo claro." }
    },
    "espuma": {
      "50": { "$type": "color", "$value": "#EFFBFB" }, "100": { "$type": "color", "$value": "#D8F5F6" },
      "200": { "$type": "color", "$value": "#BDEEEF" }, "300": { "$type": "color", "$value": "#9EE5E7" },
      "400": { "$type": "color", "$value": "#6FCFD3" }, "500": { "$type": "color", "$value": "#3FB0B6" },
      "600": { "$type": "color", "$value": "#278E95" }, "700": { "$type": "color", "$value": "#1C6F75" },
      "800": { "$type": "color", "$value": "#155257" }, "900": { "$type": "color", "$value": "#0F3236" }
    },
    "concha": {
      "50": { "$type": "color", "$value": "#FBF4F1" }, "100": { "$type": "color", "$value": "#F3E3DC" },
      "200": { "$type": "color", "$value": "#E6CCC1" }, "300": { "$type": "color", "$value": "#CDAA9C" },
      "400": { "$type": "color", "$value": "#B88A79" }, "500": { "$type": "color", "$value": "#9A5B49" },
      "600": { "$type": "color", "$value": "#7A4436" }
    }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Shantell Sans", "ui-rounded", "sans-serif"] },
    "body":    { "$type": "fontFamily", "$value": ["Figtree", "system-ui", "sans-serif"] },
    "mono":    { "$type": "fontFamily", "$value": ["Martian Mono", "ui-monospace", "monospace"] }
  },
  "size": {
    "xs": { "$type": "dimension", "$value": "0.8rem" }, "sm": { "$type": "dimension", "$value": "0.9rem" },
    "base": { "$type": "dimension", "$value": "1rem" }, "md": { "$type": "dimension", "$value": "1.25rem" },
    "lg": { "$type": "dimension", "$value": "1.563rem" }, "xl": { "$type": "dimension", "$value": "1.953rem" },
    "2xl": { "$type": "dimension", "$value": "2.441rem" }, "3xl": { "$type": "dimension", "$value": "3.052rem" },
    "4xl": { "$type": "dimension", "$value": "4.768rem" }, "5xl": { "$type": "dimension", "$value": "7.451rem" }
  },
  "space": {
    "gota": { "$type": "dimension", "$value": "4px" }, "burbuja": { "$type": "dimension", "$value": "8px" },
    "ola-corta": { "$type": "dimension", "$value": "16px" }, "ola": { "$type": "dimension", "$value": "32px" },
    "marea": { "$type": "dimension", "$value": "64px" }, "pleamar": { "$type": "dimension", "$value": "128px" }
  },
  "radius": {
    "gota": { "$type": "dimension", "$value": "6px" },
    "guijarro": { "$type": "dimension", "$value": "14px" },
    "concha": { "$type": "string", "$value": "28px 28px 28px 8px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "motion": {
    "duration": {
      "gota": { "$type": "duration", "$value": "120ms" }, "ola": { "$type": "duration", "$value": "420ms" },
      "marea": { "$type": "duration", "$value": "1200ms" }, "pleamar": { "$type": "duration", "$value": "9s" }
    },
    "easing": {
      "oleaje": { "$type": "cubicBezier", "$value": [0.45, 0.05, 0.25, 1] },
      "resaca": { "$type": "cubicBezier", "$value": [0.6, -0.25, 0.3, 1.35] },
      "calma":  { "$type": "cubicBezier", "$value": [0.37, 0, 0.63, 1] }
    }
  }
}
